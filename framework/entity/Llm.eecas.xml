<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <!-- An item is owned by exactly one request or one response, whoever writes it, and only a request-owned item can
         point at the response item it replays. -->
    <eeca id="LlmItemOwner" entity="moqui.llm.LlmItem" on-create="true" on-update="true" run-before="true">
        <actions><script><![CDATA[
            def requestOwner = entityValue.llmRequestId
            def responseOwner = entityValue.llmResponseId
            if ((requestOwner == null) == (responseOwner == null))
                throw new org.moqui.entity.EntityException("An LLM item belongs to exactly one request or one response")
            if (responseOwner != null && entityValue.sourceLlmItemId != null)
                throw new org.moqui.entity.EntityException("Only a request item can point to the response item it replays")
        ]]></script></actions>
    </eeca>
</eecas>
